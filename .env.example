# ==============================================================================
# KASIRPRO — SMART POS MOBILE CONFIGURATION
# ==============================================================================

# Supabase Project Configuration (Optional for Cloud Sync)
# Jika dikosongkan, aplikasi secara otomatis berjalan 100% offline-first
# menggunakan penyimpanan lokal SQLite (Drift) berkinerja tinggi.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Mode Aplikasi
APP_ENVIRONMENT=production
DEFAULT_CURRENCY=IDR
DEFAULT_LOCALE=id_ID
DEFAULT_TIMEZONE=Asia/Jakarta

# Pengaturan Default Toko
DEFAULT_BUSINESS_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
DEFAULT_BRANCH_ID=b1eebc99-9c0b-4ef8-bb6d-6bb9bd380b22
DEFAULT_TAX_RATE=11.0

